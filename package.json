{
  "name": "uk-wind-intelligence",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "PYTHONPATH=backend .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:all": "bash -c 'PYTHONPATH=backend .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload & vite --host 0.0.0.0'",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:backend": "PYTHONPATH=backend .venv/bin/pytest backend/tests"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@vitejs/plugin-react": "6.2.1",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
