# Frontend (Vercel) — build-time variables
# Leave VITE_API_URL empty for the same-origin Docker build; on Vercel set it to
# the deployed API origin, e.g. https://northstar-wind-api.onrender.com
VITE_API_URL=
ELEXON_API_BASE=https://data.elexon.co.uk/bmrs/api/v1

# Backend (Render) — runtime variables
# Exact browser origins allowed by CORS, comma-separated.
CORS_ORIGINS=http://localhost:5173
# Regex for additional origins (defaults to Vercel previews). Set to an empty
# value to disable regex matching entirely.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Ephemeral hosts (Render/Heroku) should use /tmp; hosts with a mounted disk can
# point this at persistent storage instead.
DATA_CACHE_DIR=.cache/elexon
DATA_CACHE_TTL_SECONDS=3600
